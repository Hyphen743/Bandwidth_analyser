# Separate PostgreSQL database used only for deployment-wide friend rankings.
# Keep real credentials in your host's secret/environment settings, never Git.
BANDWIDTH_SHARED_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Public HTTPS URL for the authenticated collector ingestion service.
BANDWIDTH_API_URL=https://your-api-host.example/api/v1/usage
